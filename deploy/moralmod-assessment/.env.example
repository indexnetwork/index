# MoralMod assessment service (all three services share these)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Lab-issued provider keys (ask for dedicated keys; their tier is the ceiling)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# Lab control plane (authorization / JWKS / research receiver)
MORALMOD_CP_BASE_URL=
MORALMOD_CP_JWKS_URL=

# Bearer Index presents on /runs (same value as Index's MORALMOD_ASSESSMENT_TOKEN)
ASSESSMENT_API_TOKEN=
