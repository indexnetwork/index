{
  "folders": [
    { "name": "🏠 root", "path": ".." },
    { "name": "⚙️ api", "path": "../services/api" },
    { "name": "🎨 web", "path": "../apps/web" },
    { "name": "🖥️ mac", "path": "../apps/mac" },
    { "name": "📡 protocol", "path": "../packages/protocol" },
    { "name": "🤖 agent", "path": "../packages/agent" },
    { "name": "💬 agent-tui", "path": "../packages/agent-tui" },
    { "name": "⌨️ cli", "path": "../packages/cli" }
  ],
  "settings": {
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "eslint.workingDirectories": [
      { "pattern": "services/*" },
      { "pattern": "apps/*" },
      { "pattern": "packages/*" }
    ],
    "files.exclude": {
      "**/.DS_Store": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/.worktrees": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/bun.lock": true,
      "**/.worktrees": true
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss",
      "oven.bun-vscode"
    ]
  }
}
