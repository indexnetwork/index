{
  "permissions": {
    "allow": ["Read", "Bash"],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/claude-post-edit-lint.sh",
            "statusMessage": "Auto-linting edited file"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/claude-pre-commit-gate.sh",
            "if": "Bash(git commit*)",
            "timeout": 60,
            "statusMessage": "Running tsc + eslint on staged files"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "linear@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "railway@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "neon@claude-plugins-official": true
  }
}
