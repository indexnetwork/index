##############################################################################
# Index monorepo — canonical environment variable reference
#
# This is the ONLY committed env file. Copy it to create your local files:
#
#   cp .env.example .env.development   # local development (API, drizzle, CLIs, Vite dev)
#   cp .env.example .env.test          # tests + protocol evals (safe/dummy values)
#
# All runtime .env* files live at the REPO ROOT and are gitignored:
#
#   .env.development  loaded when NODE_ENV=development (the default for `bun run dev`)
#   .env.test         loaded when NODE_ENV=test (API tests, protocol tests/evals)
#   .env.production   loaded when NODE_ENV=production (rarely used locally)
#   .env              fallback when NODE_ENV is unset
#
# Who reads what:
#   services/api      all non-VITE_ vars below (validated at boot by src/startup.env.ts)
#   apps/web          only VITE_-prefixed vars (build/dev time, via Vite envDir=root)
#   packages/protocol subset (DATABASE_URL, OPENROUTER_*, MCP_*) for tests/evals
#
# Deployment (Railway): variables are injected by the platform — these files are
# not used. `startup.env.ts` hard-fails on invalid vars and prints warnings for
# vars commonly forgotten in deployments. Run `bun scripts/audit-railway-env.ts`
# to diff a Railway service against this reference.
#
# Convention: required-for-dev vars are uncommented with placeholder values;
# optional vars are commented out with their defaults shown.
##############################################################################


########################################
# 1. Core
########################################

# Postgres connection
DATABASE_URL=postgresql://username:password@localhost:5432/protocol_db

# Server
PORT=3001
NODE_ENV=development

# Protocol base URL for auth, OAuth callbacks, email links. Use HTTPS in production.
# BASE_URL=https://protocol.dev.index.network

# Frontend URL (for notification links, integration OAuth callbacks)
# FRONTEND_URL=https://index.network


########################################
# 2. Authentication
########################################

# Better Auth (self-hosted authentication)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Connect redirect JWTs (for opportunity link signing)
# Generate with: openssl rand -hex 32
CONNECT_JWT_SECRET=              # Secret for signing connect redirect JWTs (48h TTL). Generate with: openssl rand -hex 32

# Public origin used to build short connect-links (e.g. https://api.index.network/c/<code>).
# Used by protocol-init.ts and opportunity.controller.ts. Precedence: BASE_URL > API_BASE_URL > APP_URL.
# Prefer setting BASE_URL (the dominant convention across the backend); API_BASE_URL is accepted as a fallback.
# API_BASE_URL=https://api.index.network
# APP_URL=https://index.network

# Google OAuth (leave empty to disable Google OAuth Login option)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated list of trusted origins for CORS
# TRUSTED_ORIGINS=http://localhost:3000


########################################
# 3. LLM / AI (OpenRouter)
########################################

# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Hard cap for individual OpenRouter requests, in ms (default: 60000)
# OPENROUTER_REQUEST_TIMEOUT_MS=60000
# Max OpenRouter retries after the initial attempt (default: 1)
# OPENROUTER_MAX_RETRIES=1

# Chat agent model (default: google/gemini-3-pro-preview)
# CHAT_MODEL=google/gemini-3-pro-preview
# CHAT_REASONING_EFFORT=low   # minimal | low | medium | high | xhigh

# Opportunity discovery/evaluation tuning
# RUN_OPPORTUNITY_EVAL_IN_PARALLEL=false    # Experimental: fire one LLM call per candidate in parallel
# DISCOVERY_CONTEXT_TO_INTENT=1             # Set to 0 to disable context-to-intent discovery
# NEGOTIATION_MAX_TURNS_CHAT=4
# NEGOTIATION_MAX_TURNS_AMBIENT=6

# Per-turn LLM round-trip cap for IndexNegotiator, in ms (default: 15000).
# Bounds individual negotiator calls so a single slow upstream tail can't blow
# the negotiate-phase budget. Valid range: (0, Number.MAX_SAFE_INTEGER]; bad
# values fall back to the default.
# NEGOTIATOR_TURN_TIMEOUT_MS=15000

# Embeddings (default: openai/text-embedding-3-large, 2000 dims)
# EMBEDDING_MODEL=openai/text-embedding-3-large
# EMBEDDING_DIMENSIONS=2000

# Smartest test framework (LLM verifier/generator overrides)
# SMARTEST_VERIFIER_MODEL=google/gemini-2.5-flash
# SMARTEST_GENERATOR_MODEL=google/gemini-2.5-flash


########################################
# 4. Redis
########################################

# Used for BullMQ job queues and cache. Default: localhost:6379, db 0.
# REDIS_URL=                   # Full URL (overrides individual settings below)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0


########################################
# 5. Storage (S3-compatible)
########################################

# Avatars, feedback images. Served via presigned URLs through /api/storage/*
# Railway buckets use https://t3.storageapi.dev as endpoint and region=auto
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# PRESIGNED_URL_EXPIRATION_SECONDS=3600


########################################
# 6. Email (Resend)
########################################

# If not set, emails are skipped.
# RESEND_API_KEY=
# EMAIL_PRODUCTION_MODE=true sends to real recipients.
# When false/absent, emails redirect to TESTING_EMAIL_ADDRESS (or skip if unset).
# EMAIL_PRODUCTION_MODE=
# TESTING_EMAIL_ADDRESS=


########################################
# 7. Integrations
########################################

# Composio (Gmail, Notion, Slack, Airtable, Google Docs)
# If not set, integrations are disabled.
# COMPOSIO_API_KEY=

# Unstructured API (document parsing). If not set, some file types are disabled.
# UNSTRUCTURED_API_URL=

# Parallels API (web crawling and profile extraction for links)
# PARALLELS_API_KEY=


########################################
# 8. Observability
########################################

# Langfuse (LLM tracing)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Sentry (error tracking, performance tracing, and release tracking)
# Backend must use the Sentry project dedicated to backend events only.
# Do not reuse this DSN for frontend, CLI, protocol package evals, or future apps;
# create a separate Sentry project + DSN for each runtime.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=index-backend@<git-sha>   # Optional; inferred from Railway/GitHub commit SHA when unset.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ENABLE_SENTRY_TEST_ENDPOINT=false

# Logging
# LOG_LEVEL=debug              # debug (dev default) | info (prod default) | warn | error
# LOG_FILTER=                  # Filter log output by pattern

# Debug API (enables /api/debug/* endpoints)
# ENABLE_DEBUG_API=false

# Per-negotiation deadline for the negotiation summarizer LLM. Aborted calls
# fall back to a deterministic digest so question generation still has
# structured input. Default: 5000.
# NEGOTIATION_SUMMARY_TIMEOUT_MS=5000

# Bull Board UI port (default: same as PORT)
# ADMIN_QUEUES_PORT=3001

########################################
# 9. Onboarding
########################################

# Comma-separated index IDs to auto-join new users to on onboarding completion.
# AUTO_JOIN_INDEX_IDS=uuid-1,uuid-2

########################################
# 10. Contact Dedup
########################################

# Deduplication strategy for bulk contact imports.
# Determines how aggressively the system merges contacts with similar names/emails.
#   conservative — near-exact matches only (default)
#   balanced     — catches common name/email variations
#   aggressive   — catches looser matches, higher false-positive risk
#   off          — disable dedup entirely
# CONTACT_DEDUP_STRATEGY=conservative

# Contacts & ghost-user creation feature flag.
# Gates the contact import / manual-add paths (HTTP POST /users/contacts,
# POST /api/integrations/:toolkit/import, and the import_contacts / add_contact /
# import_gmail_contacts MCP tools) — the only paths that mint ghost users.
# Read/remove of existing contacts and opportunity-acceptance contact links are
# unaffected. DISABLED WHEN UNSET — must be exactly "true" to enable.
CONTACTS_ENABLED=false

########################################
# 11. Telegram Bot
########################################

# Telegram Bot (optional — bot notifications and chat)
# TELEGRAM_BOT_TOKEN=          # Bot token from @BotFather
# TELEGRAM_BOT_USERNAME=       # Bot username without @, e.g. IndexBot
# TELEGRAM_WEBHOOK_SECRET=     # Random secret for webhook validation
# TELEGRAM_WEBHOOK_URL=        # Optional explicit webhook base URL; falls back to BASE_URL or APP_URL

########################################
# 12. Rate Limiter
########################################

# Rate limiter — per-route-class request budgets.
# All values are requests-per-minute. Empty/missing uses the built-in defaults.
LIMITER_AUTH_WRITE_PER_MIN=100
LIMITER_READ_PER_MIN=1200
LIMITER_WRITE_PER_MIN=600
# Comma-separated; first matching IPv4/IPv6 wins. Default chain handles Envoy + most edge proxies.
LIMITER_IP_HEADERS=x-envoy-external-address,x-forwarded-for,x-original-forwarded-for,x-real-ip
# Escape hatch: set to 1 to disable the limiter entirely (incidents only).
LIMITER_DISABLE=

########################################
# 13. QuestionerAgent
########################################
# All question-generation flags live under the QUESTIONER_ prefix and are
# hierarchical: the per-surface flags below have no effect unless
# QUESTIONER_ENABLED is true.

# Master switch: background question generation (QuestionerQueue worker +
# enqueue at every composition site: intent, enrichment, negotiation, discovery).
QUESTIONER_ENABLED=false

# Per-surface: decision questions during chat/MCP opportunity discovery
# (up to 3 structured questions after running negotiations). Adds inline
# negotiation-summarizer latency to the discovery flow, so it can be turned
# off independently of the master switch. Off by default.
# QUESTIONER_DISCOVERY_ENABLED=false

# Generator input mode: only `transcripts` is implemented; `insights` is
# planned and currently falls back to transcripts with a warning.
# QUESTIONER_DISCOVERY_INPUT_MODE=transcripts

# Per-call deadline for the discovery-questions LLM. Question generation
# returns `null` (no questions surfaced) when the deadline fires; the rest of
# the discovery payload still ships. Sized to fit inside Railway's ~60 s
# edge-proxy upstream timeout. Default: 12000.
# QUESTIONER_DISCOVERY_TIMEOUT_MS=12000

# How long the chat orchestrator's blocking ask_user_question tool waits for
# the user's inline answer before returning a timeout result (ms, default 4 min).
# Keep below MCP_TOOL_TIMEOUT_INTERACTIVE_MS so the tool times out gracefully.
# QUESTIONER_CHAT_WAIT_TIMEOUT_MS=240000

########################################
# 14. MCP / Tool Runtime
########################################

# HTTP-level /mcp request budget. Runs before MCP server/transport allocation.
# Uses the same verified-JWT-or-IP identity model as the route limiter.
# MCP_HTTP_LIMIT_PER_MIN=240

# Request body cap for the MCP endpoint (default: 1048576 bytes)
# MCP_MAX_REQUEST_BYTES=1048576

# Tool runtime timeout classes used by @indexnetwork/protocol.
# MCP_TOOL_TIMEOUT_FAST_MS=10000
# MCP_TOOL_TIMEOUT_BOUNDED_SLOW_MS=45000
# MCP_TOOL_TIMEOUT_ASYNC_CANDIDATE_MS=50000
# MCP_TOOL_TIMEOUT_INTERACTIVE_MS=300000
# MCP_TOOL_MAX_OUTPUT_BYTES=1000000

# Per-tool overrides follow the patterns MCP_TOOL_TIMEOUT_<TOOL_NAME>_MS and
# MCP_TOOL_MAX_OUTPUT_<TOOL_NAME>_BYTES, e.g.:
# MCP_TOOL_TIMEOUT_DISCOVER_OPPORTUNITIES_MS=50000
# MCP_TOOL_MAX_OUTPUT_READ_DOCS_BYTES=1000000

########################################
# 15. LangGraph checkpoint retention
########################################

# Retention window for PostgresSaver checkpoint threads (whole days).
# Chat runs checkpoint under a per-run thread_id and are never resumed after
# the run ends, so aged-out threads are pruned by an hourly cron.
# Set to 0/off/none to disable pruning entirely. Default: 7.
# CHECKPOINT_RETENTION_DAYS=7

# Max stale threads deleted per batch (clamped to [1, 1000]; up to 10 batches
# per hourly run). Default: 100.
# CHECKPOINT_PRUNE_BATCH_SIZE=100

########################################
# 16. Web app (apps/web — Vite build/dev time)
########################################
# Only VITE_-prefixed vars are exposed to the browser bundle. In local dev the
# Vite server proxies /api to the API service, so none of these are required.

# Protocol API URL (required in production builds; the build fails without it)
# VITE_PROTOCOL_URL=https://protocol.example.com

# Evaluator service URL (used by FeedbackWidget)
# VITE_EVALUATOR_URL=http://localhost:3002

# Show debug UI (DebugCopyButton) outside dev builds when set to "true"
# VITE_ENABLE_DEBUG=false
