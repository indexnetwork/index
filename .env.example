##############################################################################
# Index monorepo — canonical environment variable reference
#
# This is the ONLY committed env file. Copy it to create your local files:
#
#   cp .env.example .env.development   # local development (API, drizzle, CLIs, Vite dev)
#   cp .env.example .env.test          # then change NODE_ENV below to test
#
# Exactly two runtime env files exist, both at the REPO ROOT and gitignored:
#
#   .env.development  local development (also the default when NODE_ENV is unset)
#   .env.test         loaded when NODE_ENV=test (API tests, protocol tests/evals)
#
# There is deliberately no bare `.env` file and no `.env.production`:
# production configuration is platform-injected (Railway), never file-based.
#
# Who reads what:
#   services/api      all non-VITE_ vars below (validated at boot by src/startup.env.ts)
#   apps/web          only VITE_-prefixed vars (build/dev time, via Vite envDir=root)
#   packages/protocol subset (DATABASE_URL, OPENROUTER_*, MCP_*) for tests/evals
#
# Deployment (Railway): variables are injected by the platform — these files are
# not used. `startup.env.ts` hard-fails on invalid vars and prints warnings for
# vars commonly forgotten in deployments. Run `bun scripts/audit-railway-env.ts`
# to diff a Railway service against this reference.
#
# Convention: required-for-dev vars are uncommented with placeholder values;
# optional vars are commented out with their defaults shown.
#
# Scope legend — every section below carries a "Scope:" tag naming its consumers:
#   [global]         read by more than one workspace
#   [api]            services/api only
#   [api+protocol]   services/api AND packages/protocol (LLM/discovery runtime)
#   [web]            apps/web (Vite build/dev time)
#   [mac]            packages/mac — currently reads NO env vars
#   [cli]            packages/cli — currently reads NO env vars
##############################################################################


########################################
# 1. Core
# Scope: [global] — NODE_ENV/PORT everywhere; DATABASE_URL [api];
#        API_URL [api]; WEB_APP_URL [api+web]
########################################

# Postgres connection
# Neon naming caution: every Neon branch (production, dev, local-dev alike)
# hosts a `protocol_prod` database holding a copy of real user data. The name
# marks the DATA, not the environment — it drives the fail-closed guard in
# services/api/src/lib/drizzle/test-database-readiness.ts and must not be
# renamed. Never infer "this is production" from the database name (check the
# Neon branch/endpoint instead; see docs/guides/development-reference.md,
# "Neon Database Topology"), and never report fork query results as production
# numbers. Tests use the empty disposable `neondb` on the same branch.
DATABASE_URL=postgresql://username:password@localhost:5432/protocol_db

# Server (PORT is also read by the apps/web preview server)
PORT=3001
NODE_ENV=development

# Deployed API origin (services/api): auth, OAuth callbacks, email links,
# connect links, webhooks. Use HTTPS in production.
# API_URL=https://protocol.dev.index.network

# Deployed web app origin (apps/web): notification links, integration OAuth
# callbacks, login redirects. Also read by the web build for meta tags.
# WEB_APP_URL=https://index.network


########################################
# 2. Authentication
# Scope: [api]
########################################

# Better Auth (self-hosted authentication)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Connect redirect JWTs (for opportunity link signing)
# Generate with: openssl rand -hex 32
CONNECT_JWT_SECRET=              # Secret for signing connect redirect JWTs (48h TTL). Generate with: openssl rand -hex 32

# Short connect-links (e.g. https://protocol.index.network/c/<code>) are built
# from API_URL (section 1) — they are served by the API host, never the web app.

# Google OAuth (leave empty to disable Google OAuth Login option)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated list of browser origins allowed to make credentialed requests
# (CORS) and trusted by Better Auth. This list is the only source of that trust:
# the API never trusts a caller's own Origin header. Entries are compared exactly
# (scheme + host + port); anything that is not a valid http(s) origin is skipped
# with a warning and never widens the set.
# TRUSTED_ORIGINS=http://localhost:3000


########################################
# 3. LLM / AI (OpenRouter)
# Scope: [api+protocol]
########################################

# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Hard cap for individual OpenRouter requests, in ms (default: 60000)
# OPENROUTER_REQUEST_TIMEOUT_MS=60000
# Max OpenRouter retries after the initial attempt (default: 1)
# OPENROUTER_MAX_RETRIES=1
# Fallback model when the primary model errors (protocol runtime)
# OPENROUTER_FALLBACK_MODEL=
# Max attempts for retryable LLM runnables in the protocol runtime
# OPENROUTER_RUNNABLE_MAX_ATTEMPTS=

# Chat agent model (default: google/gemini-3-pro-preview)
# CHAT_MODEL=google/gemini-3-pro-preview
# CHAT_REASONING_EFFORT=low   # minimal | low | medium | high | xhigh

# Eval-only. Per-agent model overrides used by the eval ops site's configuration
# profiles, e.g. {"opportunityEvaluator":"anthropic/claude-sonnet-4"}.
# Ignored by the protocol when NODE_ENV=production; the API refuses to boot when
# it is set in a deployed environment (NODE_ENV=production or a Railway env).
# EVAL_MODEL_OVERRIDES=

# Opportunity discovery/evaluation tuning
# RUN_OPPORTUNITY_EVAL_IN_PARALLEL=false    # Experimental: fire one LLM call per candidate in parallel
# HYDE_FRAME_CONSTRAINTS_ENABLED=false      # Strict literal true enables source-grounded frame-v1 HyDE generation/validation
# DISCOVERY_CONTEXT_TO_INTENT=1             # Set to 0 to disable context-to-intent discovery
# INTRODUCER_DISCOVERY_ENABLED=false        # Gates automatic and on-behalf-of introducer finding; must be exactly true to enable
# DISCOVERY_SOURCE_PREMISE_LIMIT=           # Max source premises per discovery run (protocol runtime)
# DISCOVERY_ALLOWED_TYPES=intent,profile    # CSV of intent,profile — data types allowed in opportunity matching
# DISCOVERY_MIN_SIMILARITY=0.30             # Semantic retrieval cutoff, 0..1 (default: 0.30)
# DISCOVERY_EVALUATOR_MIN_SCORE=50          # Accepted evaluator score floor, 0..100 (default: 50)
# DISCOVERY_PROFILE_SOURCE=premise          # What "profile" means: premise (heavyweight, default) | user_context (lightweight paragraphs)
# PREMISE_DEDUP_SIMILARITY=                 # Premise dedup similarity threshold, 0..1 (protocol runtime)
# NEGOTIATION_MAX_TURNS_CHAT=4
# NEGOTIATION_MAX_TURNS_AMBIENT=6
# NEGOTIATION_INCLUDE_OTHER_INTENTS=true   # Strict true|false. Default true preserves bounded active-intent context (exact
                                           # opportunity-bound intent first, then up to four other active intents per participant).
                                           # Set false to give autonomous opportunity negotiations only each participant's exact
                                           # opportunity-bound intent; if that exact intent is absent, no unrelated fallback is sent.
# NEGOTIATION_PROTOCOL_VERSION=v1          # Protocol version stamped on NEW negotiations: v1 (legacy) | v2 (seat rules:
                                           # initiator outreach/counter/question/withdraw, counterparty accept/decline/counter/question).
                                           # In-flight conversations inherit their stamped version; flipping this only affects fresh negotiations.
# NEGOTIATION_SCREEN_MODE=off              # Outreach screen gate (P2.1/P2.2): off (default, no LLM call) | shadow (decide + record on
                                           # task metadata.screenDecision, never blocks) | enforce (P2.2: a pass blocks before the first
                                           # turn — outcome reason "screened_out", opportunity quietly rejected, zero counterparty
                                           # involvement; failed screens still fail open). Fresh negotiations only; continuations never screen.
# NEGOTIATOR_STANCE=advocate               # Acting negotiator's drafting stance (IND-611): advocate (default) | evaluator | skeptic.
                                           # advocate = today's prompt byte-for-byte: argue the user's case, no opportunity-cost bar, a
                                           # satisfied discovery query reads as a mandate to connect, deadlock resolves by bargaining.
                                           # evaluator = assess the match honestly first and advocate only for one that survives, adds the
                                           # opportunity-cost bar ("worth that spend", not "does no harm"), and makes query satisfaction a
                                           # precondition for continuing to evaluate rather than a reason to connect.
                                           # skeptic = evaluator plus the prior that most candidate matches are not worth making, and a
                                           # deadlock resolves as a stalemate instead of by concessions.
                                           # Prompt-only: seat vocabularies, turn schemas, and graph routing (including the
                                           # continuation-screen bypass) are identical under all three. Unset/unrecognized = advocate.
# NEGOTIATION_ASK_USER_ENABLED=false       # ask_user client-consult pause (P3.2): master gate; when true, v2 negotiators may pause mid-negotiation.
# NEGOTIATION_CONSULTATION_POLICY_MODE=off # IND-508 deterministic consultation policy: off (default/invalid = legacy behavior) |
                                           # shadow (evaluate privacy-minimized eligibility telemetry only) | on (authorize one
                                           # bounded, exact-seat consultation). Requires NEGOTIATION_ASK_USER_ENABLED=true; never
                                           # enable without a staged shadow rollout.
# NEGOTIATION_ASK_USER_WINDOW_MS=86400000  # Answer window for a paused ask_user negotiation, in ms (default: 24h). Shorten on dev
# NEGOTIATION_DEADLOCK_SHIFT_ENABLED=false # Deadlock detection + persuasion->bargaining mode shift (IND-428, dialogue-game item 6):
                                           # when literally "true", v2 negotiations that hit N consecutive counter/question turns
                                           # without convergence draft subsequent system-agent turns in a bargaining stance
                                           # (concessions/scope reductions, or ask_user escalation where already legal) instead of
                                           # re-arguing merits. Detection is deterministic (no LLM) and fail-open; actions,
                                           # termination, and turn-cap semantics are unchanged. Default off = today's behavior
                                           # byte-for-byte.
# NEGOTIATION_DEADLOCK_THRESHOLD=4         # Consecutive non-convergent (counter/question) turns that constitute a deadlock.
                                           # Integer >= 2; invalid values fall back to 4.
# NEGOTIATION_WATCHDOG_ENABLED=false      # Recover stale submitted/working negotiation tasks every 5 minutes (IND-491).
                                           # Default off; the worker and repeatable schedule are not registered when disabled.
# NEGOTIATOR_MEMORY_WRITE_ENABLED=false    # Negotiator memory write path (P5.2): when true, finished negotiations and idle
                                           # negotiator DMs are distilled into negotiator_memories, and ask_user answers are
                                           # recorded as disclosure rules. Default off; keep off in prod until memory
                                           # inspection (P5.4) ships. Nothing reads memories yet (P5.3).
# NEGOTIATOR_CHAT_REFLECT_DELAY_MS=900000  # Idle window after the last negotiator-DM turn before chat reflection fires (default: 15m).
# NEGOTIATOR_MEMORY_INJECT=false           # Negotiator memory read path (P5.3): when true, retrieved negotiator_memories shape
                                           # the screen gate, turn prompts, polling pickup payloads, and the negotiator DM
                                           # persona. Disclosure rules are hard prompt constraints; the rest are advisory
                                           # hints. Default off = prompts byte-identical to the pre-P5.3 build.
# NEGOTIATOR_CHAT_ENABLED=false            # Negotiator persona chat surface (P4.1/IND-402): POST /chat/negotiator/session and
                                           # negotiator-persona streaming on /chat/stream; surfaced to the web app as
                                           # features.negotiatorChat on GET /auth/me (gates the intent-page Personal Agent
                                           # chat, the only negotiator surface — the unscoped DM and its pinned sidebar
                                           # entry were removed). Must be exactly "true" to enable.
# WEB_AGENT_SURFACE_ENABLED=false          # Read-only Agent reporter persona (IND-476 PR1): when exactly "true", reporter
                                           # sessions may be started/continued on the main-web surface. Surfaced as
                                           # features.agentSurface on GET /auth/me. Default off; ship dark first.
# REPORTER_BRIEFING_TTL_MS=86400000         # Lazy opening-briefing lifetime (IND-484), measured from session creation rather
                                           # than follow-up activity. Positive whole milliseconds; defaults to 24 hours.
                                           # Expired reporter sessions remain readable in ordinary web history.
# CHAT_SESSION_GAP_MS=86400000              # Strict inactivity gap that opens a new durable H2A/H2H conversation session.
                                           # Positive whole milliseconds; defaults to 24 hours. A2A sessions always follow task runs.
# WEB_AGENT_ACTIONS_ENABLED=false          # IND-490 PR1: owner-confirmed reporter cleanup-action proposals. Effective only
                                           # when WEB_AGENT_SURFACE_ENABLED is true; confirm endpoint is session-only.
                                           # Default off; ship dark first. Do not flip on Railway in this PR.
                                           # to exercise the expiry path.
# FAST_SIGNAL_INTAKE=false                 # Deterministic fast intake funnel for /i/new (ship dark; flip on dev first)
                                           # when exactly "true". Gates Task 1-6 intake backend; legacy Signal Agent
                                           # intake path is untouched. Surfaced as features.fastSignalIntake on
                                           # GET /auth/me. Must be exactly "true" to enable.
# SIGNAL_INTAKE_MAX_QUESTIONS=2              # Fast-intake total question budget INCLUDING the cached round 1
                                           # (integer 1-10, default 2 = round 1 + one follow-up, the pre-config
                                           # behavior). Unparseable values fall back to 2. Server-side only.
# SIGNAL_INTAKE_QUESTION_MODE=singular       # Per-turn delivery of follow-up questions: singular = one question
                                           # per /intents/intake/question turn (default, pre-config behavior);
                                           # plural = the whole planned batch (up to n-1) in one turn.

# Per-turn LLM round-trip cap for IndexNegotiator, in ms (default: 15000).
# Bounds individual negotiator calls so a single slow upstream tail can't blow
# the negotiate-phase budget. Valid range: (0, Number.MAX_SAFE_INTEGER]; bad
# values fall back to the default.
# NEGOTIATOR_TURN_TIMEOUT_MS=15000

# Embeddings (default: openai/text-embedding-3-large, 2000 dims)
# EMBEDDING_MODEL=openai/text-embedding-3-large
# EMBEDDING_DIMENSIONS=2000

# Smartest test framework (LLM verifier/generator overrides)
# SMARTEST_VERIFIER_MODEL=google/gemini-2.5-flash
# SMARTEST_GENERATOR_MODEL=google/gemini-2.5-flash


########################################
# 4. Redis
# Scope: [api]
########################################

# Used for BullMQ job queues and cache. Default: localhost:6379, db 0.
# REDIS_URL=                   # Full URL (overrides individual settings below)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0


########################################
# 5. Storage (S3-compatible)
# Scope: [api]
########################################

# Avatars, feedback images. Served via presigned URLs through /api/storage/*
# Railway buckets use https://t3.storageapi.dev as endpoint and region=auto
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# PRESIGNED_URL_EXPIRATION_SECONDS=3600


########################################
# 6. Email (Resend)
# Scope: [api]
########################################

# If not set, emails are skipped.
# RESEND_API_KEY=
# EMAIL_PRODUCTION_MODE=true sends to real recipients.
# When false/absent, emails redirect to TESTING_EMAIL_ADDRESS (or skip if unset).
# EMAIL_PRODUCTION_MODE=
# TESTING_EMAIL_ADDRESS=


########################################
# 7. Integrations
# Scope: [api]
########################################

# Composio (Gmail, Notion, Slack, Airtable, Google Docs)
# If not set, integrations are disabled.
# COMPOSIO_API_KEY=

# Unstructured API (document parsing). If not set, some file types are disabled.
# UNSTRUCTURED_API_URL=

# Parallels API (web crawling and profile extraction for links)
# PARALLELS_API_KEY=

# unavatar.io — resolves a user's avatar during enrichment from their
# github/twitter/telegram handle or email. Optional. Without a token the public
# endpoint is rate-limited (~25 requests/day per IP); set a publishable `pk_*`
# token to use the PRO quota. UNAVATAR_BASE overrides the endpoint for a
# self-hosted instance (default https://unavatar.io).
# UNAVATAR_TOKEN=
# UNAVATAR_BASE=https://unavatar.io


########################################
# 8. Observability
# Scope: [api]
########################################

# Sentry (error tracking, performance tracing, and release tracking)
# Backend must use the Sentry project dedicated to backend events only.
# Do not reuse this DSN for frontend, CLI, protocol package evals, or future apps;
# create a separate Sentry project + DSN for each runtime.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=index-backend@<git-sha>   # Optional; inferred from Railway/GitHub commit SHA when unset.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ENABLE_SENTRY_TEST_ENDPOINT=false

# Logging
# LOG_LEVEL=debug              # debug (dev default) | info (prod default) | warn | error
# LOG_FILTER=                  # Filter log output by pattern

# Debug API (enables /api/debug/* endpoints)
# ENABLE_DEBUG_API=false

# Per-negotiation deadline for the negotiation summarizer LLM. Aborted calls
# fall back to a deterministic digest so question generation still has
# structured input. Default: 5000.
# NEGOTIATION_SUMMARY_TIMEOUT_MS=5000

# Bull Board UI port (default: same as PORT)
# ADMIN_QUEUES_PORT=3001

########################################
# 9. Onboarding
# Scope: [api]
########################################

# Comma-separated index IDs to auto-join new users to on onboarding completion.
# AUTO_JOIN_INDEX_IDS=uuid-1,uuid-2

########################################
# 10. Contact Dedup
# Scope: [api]
########################################

# Deduplication strategy for bulk contact imports.
# Determines how aggressively the system merges contacts with similar names/emails.
#   conservative — near-exact matches only (default)
#   balanced     — catches common name/email variations
#   aggressive   — catches looser matches, higher false-positive risk
#   off          — disable dedup entirely
# CONTACT_DEDUP_STRATEGY=conservative

# Contacts & ghost-user creation feature flag.
# Gates the contact import / manual-add paths (HTTP POST /users/contacts,
# POST /api/integrations/:toolkit/import, and the import_contacts / add_contact /
# import_gmail_contacts MCP tools) — the only paths that mint ghost users.
# Read/remove of existing contacts and opportunity-acceptance contact links are
# unaffected. DISABLED WHEN UNSET — must be exactly "true" to enable.
CONTACTS_ENABLED=false

########################################
# 11. Telegram Bot
# Scope: [api]
########################################

# Telegram Bot (optional — bot notifications and chat)
# HIDING THE GATEWAY: leave TELEGRAM_BOT_TOKEN/TELEGRAM_WEBHOOK_SECRET unset and the
# gateway is fully off — no webhook registration, outbound sends no-op with one warning.
# The Telegram identity binding on user socials and delivery data stay intact.
# Setting only the SECRET is a half-configured gateway: updates authenticate but can
# never be answered, so they are acknowledged (200) and dropped before the chat agent
# runs. Unset both rather than one.
# TELEGRAM_BOT_TOKEN=          # Bot token from @BotFather
# TELEGRAM_BOT_USERNAME=       # Bot username without @, e.g. IndexBot
# TELEGRAM_WEBHOOK_SECRET=     # Random secret for webhook validation
# TELEGRAM_WEBHOOK_URL=        # Optional explicit webhook base URL; falls back to API_URL

########################################
# 12. Rate Limiter
# Scope: [api]
########################################

# Rate limiter — per-route-class request budgets.
# All values are requests-per-minute. Empty/missing uses the built-in defaults.
LIMITER_AUTH_WRITE_PER_MIN=100
LIMITER_READ_PER_MIN=1200
LIMITER_WRITE_PER_MIN=600
# Routes that launch an LLM synthesis + intent graph per call (/intents/intake/prepare, /revise, /proposal).
LIMITER_INTAKE_SYNTHESIS_PER_MIN=20
# Comma-separated; first matching IPv4/IPv6 wins. Default chain handles Envoy + most edge proxies.
LIMITER_IP_HEADERS=x-envoy-external-address,x-forwarded-for,x-original-forwarded-for,x-real-ip
# Escape hatch: set to 1 to disable the limiter entirely (incidents only).
LIMITER_DISABLE=

########################################
# 13. QuestionerAgent
# Scope: [api+protocol]
########################################
# All question-generation flags live under the QUESTIONER_ prefix and are
# hierarchical: the per-surface flags below have no effect unless
# QUESTIONER_ENABLED is true.

# Master switch: background question generation (QuestionerQueue worker +
# enqueue at every composition site: intent, enrichment, negotiation, discovery).
QUESTIONER_ENABLED=false

# Per-surface: advisory preparatory-condition questions for recipients when an
# opportunity becomes pending. Requires QUESTIONER_ENABLED=true. Off by default.
QUESTIONER_UPTAKE_ENABLED=false

# Intent felicity-authority score (0-100) below which uptake clarification is
# eligible. Unknown scores are skipped. Default: 70.
QUESTIONER_UPTAKE_AUTHORITY_THRESHOLD=70

# How long the chat persona's blocking ask_user_question tool waits for
# the user's inline answer before returning a timeout result (ms, default 4 min).
# Keep below MCP_TOOL_TIMEOUT_INTERACTIVE_MS so the tool times out gracefully.
# QUESTIONER_CHAT_WAIT_TIMEOUT_MS=240000

# Pool-aware discriminator questions (IND-416). P1 shadow mode: on discovery-run
# completion, mine discriminating axes over the candidate pool (pool >= 5) and
# log axis + VoI scores under the "PoolDiscriminatorMiner" logger for human review.
# No questions are generated and no user-facing behavior changes. Independent
# of QUESTIONER_ENABLED. Values: off (default) | shadow.
# POOL_QUESTIONS_MINING=off

# P2 (IND-418): turn the top-VoI discriminator into a pool_discovery question
# the Personal Agent asks on the intent page (chip options + "Both matter" +
# evidence chip; interview-mode chaining on answer). "on" implies mining runs
# even when POOL_QUESTIONS_MINING is off; the actual enqueue additionally
# requires QUESTIONER_ENABLED=true. Budget: <=1 pending pool question and <=3
# pending total per intent. Values: off (default) | on.
# POOL_QUESTIONS_MODE=off

# P5 (IND-421): proactively deliver only high-VoI pool questions to the
# Personal Agent badge and the negotiator session pinned to the claim's own
# intent. Requires POOL_QUESTIONS_MODE=on, NEGOTIATOR_CHAT_ENABLED=true, and an
# available personal negotiator. Strict pool/visit/cycle/dismissal/daily budgets
# apply, and a claim whose pinned intent can no longer resolve a session
# (archived, deleted, or not the recipient's) is suppressed, not retried.
# Ship dark: unset/off is always inert. Values: off (default) | on.
# POOL_QUESTIONS_PUSH=off

# P3 (IND-419): order the home feed + intent-page matches by pool-adjusted
# confidence (confidence x product of poolAdjustments factors, floor 0.3).
# Adjustments are WRITTEN on every pool_discovery answer regardless of this
# flag — it only gates whether ordering reads them, so the apply path can
# ship first. Values: off (default) | on.
# POOL_QUESTIONS_RANKING=off

# P4b (IND-420): before inserting genuinely new intent-discovery opportunities,
# classify the call-local candidates against still-current answered pool axes and
# stamp the same deterministic 1.0/0.6/0.9 adjustments used by P3. Requires both
# this flag and POOL_QUESTIONS_MODE=on. Provider/lookup/fingerprint failures are
# fail-open and never block INSERT. Values: off (default) | on.
# POOL_QUESTIONS_STAMP_NEWBORN=off

# IND-439 (visibility-audit slice): re-mine an intent's pool when its owner
# opens the intent page and no live pending pool_discovery question exists,
# so an expired question's intent can mint a fresh one without waiting for a
# discovery run. Debounced to one visit-triggered run per caller+intent per
# 6h via BullMQ deduplication. Adds only a *when*: every existing gate applies
# unchanged (POOL_QUESTIONS_MODE=on required — the trigger is a no-op when
# mode is off — plus QUESTIONER_ENABLED, the >=5 pool k-anonymity floor, VoI
# threshold, <=1 pool pending / <=3 total pending per intent, fingerprint
# freshness, and push budgets). Expired rows are never resurrected and the
# 7-day TTL is unchanged. Ship dark: unset/off is always inert.
# Values: off (default) | on.
# POOL_QUESTIONS_VISIT_TRIGGER=off

# Lens C (IND-433): mine neutral clarification hypotheses from RECURRING
# negotiation evidence, read in place at mining time from the exact recipient +
# intent/fingerprint + opportunity + task segments. Only future negotiation tasks
# carrying immutable intent snapshots captured at task creation are eligible;
# pre-deployment tasks fail closed. The API producer omits opportunity
# metadata.userAnswers entirely (it lacks answer-author/type provenance and can
# contain synthetic expiry disclosure text). Only structured
# bilateral actions/coarse outcomes and explicitly shared message content are
# read; screen/evaluator reasoning, chain-of-thought, memoryHints, private
# memories/reflections, disclosure subjects, untagged answers, and old digests
# are excluded by construction. A hypothesis is kept
# only when every support reference resolves to allowlisted evidence and it
# recurs across >=5 distinct opportunities. shadow mines + verifies and emits
# AGGREGATE telemetry only (no questions, no ranking/intent/premise/memory/
# policy/newborn/push changes). Values: off (default) | shadow | on.
# NEGOTIATION_EVIDENCE_QUESTIONS_MODE=off

# Lens B — explicit opportunity outcomes and grounded questions (IND-434, P7).
# On each EXPLICIT owner action (accept/reject) on an opportunity, record one
# idempotent, append-only feedback event scoped to the exact recipient + intent
# + intent fingerprint, then mine neutral trade-off hypotheses over the user's
# own past decisions and log ONLY aggregate telemetry under the
# "OutcomeQuestionMiner" logger for human review. Candidates are assigned to
# hypothesis sides BLIND to their outcome; labels are joined only afterwards.
# Related opportunities are deduplicated and every compared side needs >= 5
# independent examples. Counterparty, agent, screening, timeout, merge, cascade,
# TTL/expiry, and delivery transitions are never treated as preferences. No
# question, ranking, intent, premise, memory, newborn-stamp, or push writes.
# "shadow" (this issue) and "on" both run capture + mining; "on" (reserved for
# IND-438) additionally emits questions in a later phase. Independent of
# QUESTIONER_ENABLED. Values: off (default) | shadow | on.
# OUTCOME_QUESTIONS_MODE=off

########################################
# 14. MCP / Tool Runtime
# Scope: [api+protocol]
########################################

# HTTP-level /mcp request budget. Runs before MCP server/transport allocation.
# Uses the same verified-JWT-or-IP identity model as the route limiter.
# MCP_HTTP_LIMIT_PER_MIN=240

# Request body cap for the MCP endpoint (default: 1048576 bytes)
# MCP_MAX_REQUEST_BYTES=1048576

# Tool runtime timeout classes used by @indexnetwork/protocol.
# MCP_TOOL_TIMEOUT_FAST_MS=10000
# MCP_TOOL_TIMEOUT_BOUNDED_SLOW_MS=45000
# MCP_TOOL_TIMEOUT_ASYNC_CANDIDATE_MS=50000
# MCP_TOOL_TIMEOUT_INTERACTIVE_MS=300000
# MCP_TOOL_MAX_OUTPUT_BYTES=1000000

# Per-tool overrides follow the patterns MCP_TOOL_TIMEOUT_<TOOL_NAME>_MS and
# MCP_TOOL_MAX_OUTPUT_<TOOL_NAME>_BYTES, e.g.:
# MCP_TOOL_TIMEOUT_DISCOVER_OPPORTUNITIES_MS=50000
# MCP_TOOL_MAX_OUTPUT_READ_DOCS_BYTES=1000000

# HMAC secret for owner-issued opportunity approval proofs (IND-593). Signs the
# single-use proofs an owner issues after explicitly approving an agent's
# update_opportunity interaction challenge. Optional — falls back to
# BETTER_AUTH_SECRET. Rotate by setting a dedicated value.
# OPPORTUNITY_OWNER_APPROVAL_SECRET=generate-with-openssl-rand-base64-32

########################################
# 15. LangGraph checkpoint retention
# Scope: [api]
########################################

# Retention window for PostgresSaver checkpoint threads (whole days).
# Chat runs checkpoint under a per-run thread_id and are never resumed after
# the run ends, so aged-out threads are pruned by an hourly cron.
# Set to 0/off/none to disable pruning entirely. Default: 7.
# CHECKPOINT_RETENTION_DAYS=7

# Max stale threads deleted per batch (clamped to [1, 1000]; up to 10 batches
# per hourly run). Default: 100.
# CHECKPOINT_PRUNE_BATCH_SIZE=100

########################################
# 15b. Frame-drift measurement
# Scope: [api]
########################################

# Measurement-only daily snapshots. Disabled by default; enabling does not
# mutate embeddings, prompts, assignments, opportunities, or networks.
# FRAME_DRIFT_MONITORING_ENABLED=false
# FRAME_DRIFT_MONITORING_SCHEDULE='15 0 * * *'
# FRAME_DRIFT_MONITORING_MAX_NETWORKS=200
# FRAME_DRIFT_MONITORING_MAX_PAIRS=10000
# FRAME_DRIFT_MONITORING_MIN_USERS=5

########################################
# 15c. Test harness (repo-root .env.test only)
# Scope: [api]
########################################

# Test commands lock NODE_ENV before loading this file. A copied .env.test must
# change the Core section's NODE_ENV=development to NODE_ENV=test (or remove it);
# conflicting values abort before database access or migration safety checks.
# Database-backed tests fail closed unless this marker is explicitly enabled.
# DATABASE_URL must point to a dedicated disposable database, never shared/prod.
# TEST_DATABASE_SAFE=1
#
# Provision that database locally with `bun run db:setup:local` (Homebrew
# postgresql@17 + pgvector, database `index_test`, migrations applied), then set
# the repo-root .env.test to:
#   DATABASE_URL=postgresql://<your-unix-user>@localhost:5432/index_test
# Local Postgres is strongly preferred over a remote branch: the same four
# questioner adapter suites take ~0.6 s locally versus ~340 s against remote
# Neon, and the remote runs were intermittently stalling for minutes at a time.

# Opt into live/paid provider tests (also requires each provider credential).
# RUN_PAID_INTEGRATION_TESTS=1

# Opt into Redis integration tests. REDIS_URL is required and must identify a
# dedicated disposable Redis instance; tests never fall back to localhost.
# RUN_REDIS_INTEGRATION_TESTS=1

# Opt into E2E tests that call an already-running localhost API server.
# RUN_LOCAL_API_E2E=1

########################################
# 15d. Discovery eval gate (repo-root .env.test, for CLI runs)
# Scope: [eval] — the `discovery` CLI and the eval-ops server, never the API
########################################

# The `discovery` harness (services/api, `bun run eval:discovery`) runs the real
# discovery graph against real Neon branches: it RESETS them, writes to them, and
# spends tokens. Every invocation but `--help` refuses to start without all four
# of the variables below, before it imports anything that can compose a database.

# Secret manifest v2 naming the protected-base read replica and the two writable
# evaluation children. Every databaseUrl contains credentials: store the whole
# value only in the operator's secret manager, never in this file or shell history.
# Legacy A/B accepts v2 by projecting only the two child targets; historical
# quality requires v2 and jointly attests all roles.
# DISCOVERY_TARGETS={"version":2,"projectId":"<project-id>","baseBranchId":"<base-branch-id>","baseReadReplica":{"endpointId":"<read-only-endpoint-id>","databaseUrl":"<secret-postgresql-protocol_eval-url>"},"targets":[{"sideId":"a","branchId":"<side-a-branch-id>","endpointId":"<side-a-read-write-endpoint-id>","databaseUrl":"<secret-postgresql-protocol_eval-url>"},{"sideId":"b","branchId":"<side-b-branch-id>","endpointId":"<side-b-read-write-endpoint-id>","databaseUrl":"<secret-postgresql-protocol_eval-url>"}]}

# Separate secret declaration for the protected base's writable refresh endpoint.
# Refresh attests and uses only this read_write role; verify attests and uses only
# DISCOVERY_TARGETS.baseReadReplica. Never substitute one role for the other.
# DISCOVERY_QUALITY_BASE_REFRESH_TARGET={"version":2,"projectId":"<project-id>","branchId":"<base-branch-id>","endpointId":"<base-read-write-endpoint-id>","databaseName":"protocol_eval","databaseUrl":"<secret-postgresql-protocol_eval-url>"}

# Set only for the one separately confirmed provisioning invocation, then unset.
# DISCOVERY_QUALITY_READ_REPLICA_CONFIRM=provision IND-638 base read replica

# Parent-only SHA-256 digest identifying the paid provider account used by a
# quality run. This is an identifier digest, not an API key.
# HISTORICAL_QUALITY_PROVIDER_ACCOUNT_FINGERPRINT=<64-lowercase-hex>

# Control-plane key able to create and delete branches. Required up front,
# because every process attests its targets before it loads the graph.
# NEON_API_KEY=

# Explicit consent to a mutating, paid run. Set this ONLY for a CLI invocation.
# It is NOT read from the eval-ops service environment: that server asserts
# DISCOVERY_CONFIRM=1 and TEST_DATABASE_SAFE=1 onto the child it spawns
# (`ops.server.ts`, `asserts`), because the operator already consented by
# configuring the manifest and launching the harness. Setting it as a service
# variable would widen nothing and claim more than the service needs.
# DISCOVERY_CONFIRM=1

# TEST_DATABASE_SAFE=1 is the fourth gate variable; see section 15c above. The
# same note applies: the eval-ops server asserts it onto the child rather than
# reading it from its own environment.

########################################
# 16. Web app
# Scope: [web] — Vite build/dev time; only VITE_-prefixed vars reach the browser
########################################
# Only VITE_-prefixed vars are exposed to the browser bundle. In local dev the
# Vite server proxies /api to the API service, so none of these are required.

# Protocol API URL (required in production builds; the build fails without it)
# VITE_PROTOCOL_URL=https://protocol.example.com

# Evaluator service URL (used by FeedbackWidget)
# VITE_EVALUATOR_URL=http://localhost:3002

# Show debug UI (DebugCopyButton) outside dev builds when set to "true"
# VITE_ENABLE_DEBUG=false
