
# Index monorepo — canonical environment variable reference
#
# This is the ONLY committed env file. Copy it to create your local files:
#
#   cp .env.example .env.development   # local development (API, drizzle, CLIs, Vite dev)
#   cp .env.example .env.test          # then change NODE_ENV below to test
#
# Exactly two runtime env files exist, both at the REPO ROOT and gitignored:
#
#   .env.development  local development (also the default when NODE_ENV is unset)
#   .env.test         loaded when NODE_ENV=test (API tests, protocol tests)
#
# There is deliberately no bare `.env` file and no `.env.production`:
# production configuration is platform-injected (Railway), never file-based.
#
# Who reads what:
#   services/api      all non-VITE_ vars below (validated at boot by src/startup.env.ts)
#   apps/web          only VITE_-prefixed vars (build/dev time, via Vite envDir=root)
#   packages/protocol subset (DATABASE_URL, OPENROUTER_API_KEY) for tests
#
# Deployment (Railway): variables are injected by the platform — these files are
# not used. `startup.env.ts` hard-fails on invalid vars and prints warnings for
# vars commonly forgotten in deployments. Run `bun scripts/audit-railway-env.ts`
# to diff a Railway service against this reference.
#
# EVERYTHING HERE IS A CREDENTIAL, AN ENDPOINT, OR A TEST OPT-IN.
# There are no feature flags. Behaviour ships on, for everyone, in every
# environment — see docs/guides/feature-flags.md for what to do instead of
# adding one. Two exceptions earn their place because they are values rather
# than gates: CHAT_MODEL / CHAT_REASONING_EFFORT (which model answers) and
# LOG_LEVEL (an incident lever).
#
# Convention: required-for-dev vars are uncommented with placeholder values;
# optional vars are commented out with their defaults shown.
#
# Scope legend — every section below carries a "Scope:" tag naming its consumers:
#   [global]         read by more than one workspace
#   [api]            services/api only
#   [api+protocol]   services/api AND packages/protocol
#   [web]            apps/web (Vite build/dev time)


########################################
# 1. Core
# Scope: [global] — NODE_ENV/PORT everywhere; DATABASE_URL [api];
#        API_URL [api]; WEB_APP_URL [api+web]
########################################

# Postgres connection
# Neon naming caution: every Neon branch (production, dev, local-dev alike)
# hosts a `protocol_prod` database holding a copy of real user data. The name
# marks the DATA, not the environment — it drives the fail-closed guard in
# services/api/src/lib/drizzle/test-database-readiness.ts and must not be
# renamed. Never infer "this is production" from the database name (check the
# Neon branch/endpoint instead; see docs/guides/development-reference.md,
# "Neon Database Topology"), and never report fork query results as production
# numbers. Tests use the empty disposable `neondb` on the same branch.
DATABASE_URL=postgresql://username:password@localhost:5432/protocol_db

# Server (PORT is also read by the apps/web preview server)
PORT=3001
NODE_ENV=development

# Deployed API origin (services/api): auth, OAuth callbacks, email links,
# webhooks. Use HTTPS in production.
# API_URL=https://protocol.dev.index.network

# Deployed web app origin (apps/web): notification links, integration OAuth
# callbacks, login redirects. Also read by the web build for meta tags.
# WEB_APP_URL=https://index.network


########################################
# 2. Authentication
# Scope: [api]
########################################

# Better Auth (self-hosted authentication)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (leave empty to disable Google OAuth Login option)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated list of browser origins allowed to make credentialed requests
# (CORS) and trusted by Better Auth. This list is the only source of that trust:
# the API never trusts a caller's own Origin header. Entries are compared exactly
# (scheme + host + port); anything that is not a valid http(s) origin is skipped
# with a warning and never widens the set.
# TRUSTED_ORIGINS=http://localhost:3000

# Comma-separated emails treated as staff (services/api/src/lib/staff.ts).
# STAFF_EMAILS=

# HMAC secret for owner-issued opportunity approval proofs (IND-593). Signs the
# single-use proofs an owner issues after explicitly approving an agent's
# update_opportunity interaction challenge. Optional — falls back to
# BETTER_AUTH_SECRET. Rotate by setting a dedicated value.
# OPPORTUNITY_OWNER_APPROVAL_SECRET=generate-with-openssl-rand-base64-32


########################################
# 3. LLM / AI (OpenRouter)
# Scope: [api+protocol]
########################################

# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Chat agent model and reasoning effort. Values, not gates: they choose which
# model answers, and every environment currently runs the two below.
# CHAT_MODEL=google/gemini-3-flash-preview
# CHAT_REASONING_EFFORT=high   # minimal | low | medium | high | xhigh

# Local-only. Per-agent model overrides for ad-hoc experiments,
# e.g. {"opportunityEvaluator":"anthropic/claude-sonnet-4"}.
# Ignored by the protocol when NODE_ENV=production; the API refuses to boot when
# it is set in a deployed environment (NODE_ENV=production or a Railway env).
# EVAL_MODEL_OVERRIDES=


########################################
# 4. Redis
# Scope: [api]
########################################

# Used for BullMQ job queues and cache. Default: localhost:6379, db 0.
# REDIS_URL=                   # Full URL (overrides individual settings below)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0


########################################
# 5. Storage (S3-compatible)
# Scope: [api]
########################################

# Avatars, feedback images. Served via presigned URLs through /api/storage/*
# Railway buckets use https://t3.storageapi.dev as endpoint and region=auto
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key


########################################
# 6. Email (Resend)
# Scope: [api]
########################################

# If not set, emails are skipped.
# RESEND_API_KEY=
# EMAIL_PRODUCTION_MODE=true sends to real recipients.
# When false/absent, emails redirect to TESTING_EMAIL_ADDRESS (or skip if unset).
# EMAIL_PRODUCTION_MODE=
# TESTING_EMAIL_ADDRESS=


########################################
# 7. Integrations
# Scope: [api]
########################################

# Composio (Gmail, Notion, Slack, Airtable, Google Docs)
# If not set, integrations are disabled.
# COMPOSIO_API_KEY=

# Unstructured API (document parsing). If not set, some file types are disabled.
# UNSTRUCTURED_API_URL=

# Parallels API (web crawling and profile extraction for links)
# PARALLELS_API_KEY=

# unavatar.io — resolves a user's avatar during enrichment from their
# github/twitter/telegram handle or email. Optional. Without a token the public
# endpoint is rate-limited (~25 requests/day per IP); set a publishable `pk_*`
# token to use the PRO quota. UNAVATAR_BASE overrides the endpoint for a
# self-hosted instance (default https://unavatar.io).
# UNAVATAR_TOKEN=
# UNAVATAR_BASE=https://unavatar.io


########################################
# 8. Telegram Bot
# Scope: [api]
########################################

# Telegram Bot (optional — bot notifications and chat)
# HIDING THE GATEWAY: leave TELEGRAM_BOT_TOKEN/TELEGRAM_WEBHOOK_SECRET unset and the
# gateway is fully off — no webhook registration, outbound sends no-op with one warning.
# The Telegram identity binding on user socials and delivery data stay intact.
# Setting only the SECRET is a half-configured gateway: updates authenticate but can
# never be answered, so they are acknowledged (200) and dropped before the chat agent
# runs. Unset both rather than one.
# TELEGRAM_BOT_TOKEN=          # Bot token from @BotFather
# TELEGRAM_BOT_USERNAME=       # Bot username without @, e.g. IndexBot
# TELEGRAM_WEBHOOK_SECRET=     # Random secret for webhook validation
# TELEGRAM_WEBHOOK_URL=        # Optional explicit webhook base URL; falls back to API_URL


########################################
# 9. Observability
# Scope: [api]
########################################

# Sentry (error tracking, performance tracing, and release tracking)
# Backend must use the Sentry project dedicated to backend events only.
# Do not reuse this DSN for frontend, CLI, or future apps;
# create a separate Sentry project + DSN for each runtime.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=index-backend@<git-sha>   # Optional; inferred from Railway/GitHub commit SHA when unset.

# Logging. An incident lever: turn it up to see more, turn it down when done.
# LOG_LEVEL=debug              # verbose | debug (dev default) | info (prod default) | warn | error


########################################
# 10. Test harness (repo-root .env.test only)
# Scope: [api]
########################################

# Test commands lock NODE_ENV before loading this file. A copied .env.test must
# change the Core section's NODE_ENV=development to NODE_ENV=test (or remove it);
# conflicting values abort before database access or migration safety checks.
# Database-backed tests fail closed unless this marker is explicitly enabled.
# DATABASE_URL must point to a dedicated disposable database, never shared/prod.
# TEST_DATABASE_SAFE=1
#
# Provision that database locally with `bun run db:setup:local` (Homebrew
# postgresql@17 + pgvector, database `index_test`, migrations applied), then set
# the repo-root .env.test to:
#   DATABASE_URL=postgresql://<your-unix-user>@localhost:5432/index_test
# Local Postgres is strongly preferred over a remote branch: the same four
# questioner adapter suites take ~0.6 s locally versus ~340 s against remote
# Neon, and the remote runs were intermittently stalling for minutes at a time.

# Opt into live/paid provider tests (also requires each provider credential).
# RUN_PAID_INTEGRATION_TESTS=1

# Opt into Redis integration tests. REDIS_URL is required and must identify a
# dedicated disposable Redis instance; tests never fall back to localhost.
# RUN_REDIS_INTEGRATION_TESTS=1

# Opt into E2E tests that call an already-running localhost API server.
# RUN_LOCAL_API_E2E=1


########################################
# 11. Web app
# Scope: [web] — Vite build/dev time; only VITE_-prefixed vars reach the browser
########################################
# Only VITE_-prefixed vars are exposed to the browser bundle. In local dev the
# Vite server proxies /api to the API service, so none of these are required.

# Protocol API URL (required in production builds; the build fails without it)
# VITE_PROTOCOL_URL=https://protocol.example.com

# Evaluator service URL (used by FeedbackWidget)
# VITE_EVALUATOR_URL=http://localhost:3002

# Show debug UI (DebugCopyButton) outside dev builds when set to "true"
# VITE_ENABLE_DEBUG=false
