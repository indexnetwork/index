#!/usr/bin/env bash
set -euo pipefail

# ── llms.txt context generation ──────────────────────────────────────
changed_llms=$(git diff --cached --name-only | grep -E '^(llms\.txt|llms-full\.txt)$' || true)
if [[ -n "${changed_llms}" ]]; then
  echo "[pre-commit] Detected llms.txt changes; generating ctx files..."
  scripts/generate-ctx.sh || {
    echo "[pre-commit] Warning: ctx generation failed; proceeding without blocking commit" >&2
  }
  git add llms-ctx.txt llms-ctx-full.txt apps/web/public/llms-ctx.txt apps/web/public/llms-ctx-full.txt || true
fi

# ── Lint staged files ────────────────────────────────────────────────
echo "[pre-commit] Running lint-staged..."
bunx lint-staged || {
  echo "[pre-commit] Lint-staged failed. Fix lint errors before committing."
  exit 1
}

# ── Typecheck packages touched by this commit ────────────────────────
staged=$(git diff --cached --name-only)

typecheck_if() {
  local prefix="$1" label="$2" dir="$3"
  shift 3
  printf '%s\n' "$staged" | grep -q "^${prefix}" || return 0
  echo "[pre-commit] Checking ${label}..."
  (cd "$dir" && "$@") || {
    echo "[pre-commit] ${label} check failed." >&2
    exit 1
  }
}

typecheck_if packages/protocol/ protocol packages/protocol bunx tsc --noEmit
typecheck_if services/api/ api services/api bun run typecheck
typecheck_if packages/client/ client packages/client bun run typecheck
typecheck_if packages/agent/ agent packages/agent bun run typecheck
typecheck_if apps/web/ web apps/web bun run build

# ── Hermes plugin bundle parity ──────────────────────────────────────
# CI's typecheck job rebuilds the committed Hermes bundles and fails on
# any diff, so rebuild and restage them whenever their inputs change.
# build:runtime pins Bun through bunx so the output matches CI's bytes.
hermes_runtime=$(printf '%s\n' "$staged" | grep -E '^packages/hermes-plugin/runtime/src/' || true)
hermes_desktop=$(printf '%s\n' "$staged" | grep -E '^packages/hermes-plugin/(dashboard/dist/|desktop/)' | grep -v 'desktop/plugin\.js$' || true)
if [[ -n "${hermes_runtime}" ]]; then
  echo "[pre-commit] Rebuilding Hermes runtime bundle..."
  (cd packages/hermes-plugin && bun run typecheck:runtime && bun run build:runtime) || {
    echo "[pre-commit] Hermes runtime bundle rebuild failed." >&2
    exit 1
  }
  git add packages/hermes-plugin/runtime/dist/negotiator.js
fi
if [[ -n "${hermes_desktop}" ]]; then
  echo "[pre-commit] Rebuilding Hermes desktop plugin..."
  (cd packages/hermes-plugin && bun run build:desktop) || {
    echo "[pre-commit] Hermes desktop plugin rebuild failed." >&2
    exit 1
  }
  git add packages/hermes-plugin/desktop/plugin.js
fi

# ── Adapter naming check (only if adapter files are staged) ─────────
changed_adapters=$(git diff --cached --name-only | grep -E '^services/api/src/adapters/.*\.ts$' || true)
if [[ -n "${changed_adapters}" ]]; then
  echo "[pre-commit] Checking adapter naming conventions..."
  scripts/check-adapter-names.sh || exit 1
fi

exit 0
