<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Index</string>
    <key>CFBundleDisplayName</key>
    <string>Index — Workbench 1.3</string>
    <key>CFBundleIdentifier</key>
    <string>network.index.system6</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>Index</string>
    <!-- CFBundleIconFile points at Resources/AppIcon.icns. CFBundleIconName is
         deliberately absent: it names an asset-catalog icon, which macOS
         prefers over the .icns, so with both set the bundle drew whatever was
         compiled into Assets.car and edits to the .icns did nothing. Rebuilding
         Assets.car from AppIcon.icon needs actool (full Xcode), which this
         build does not require for anything else. Restore the key and rebuild
         the catalog together, or not at all. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>network.index.system6</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>index</string>
            </array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
