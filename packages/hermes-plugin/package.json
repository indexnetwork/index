{
  "name": "@indexnetwork/hermes-plugin",
  "version": "0.41.2",
  "description": "Hermes-native Index Network plugin with CLI tools and REST APIs",
  "license": "MIT",
  "type": "module",
  "homepage": "https://index.network",
  "repository": {
    "type": "git",
    "url": "https://github.com/indexnetwork/hermes-plugin.git"
  },
  "files": [
    "plugin.yaml",
    "__init__.py",
    "schemas.py",
    "tools.py",
    "transport.py",
    "env_transport.py",
    "principal_state.py",
    "native_agent.py",
    "bridge.py",
    "sidecar.py",
    "events.py",
    "runtime/dist/",
    "dashboard/",
    "desktop/dist/",
    "tests/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/*.py[cod]"
  ],
  "scripts": {
    "build:desktop": "node desktop/build.mjs",
    "build:runtime": "bun build ./runtime/src/main.ts --outfile runtime/dist/negotiator.js --target bun --format esm",
    "typecheck:runtime": "tsc -p runtime/tsconfig.json"
  }
}
