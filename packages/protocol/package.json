{
  "name": "@indexnetwork/protocol",
  "version": "23.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./question-block": {
      "types": "./dist/shared/schemas/question-block.schema.d.ts",
      "import": "./dist/shared/schemas/question-block.schema.js"
    },
    "./question-block/fixture": {
      "types": "./dist/shared/schemas/question-block.fixture.d.ts",
      "import": "./dist/shared/schemas/question-block.fixture.js"
    }
  },
  "files": [
    "dist",
    "IMPLEMENTATION.md",
    "STABILITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:package": "rm -rf dist && tsc --project tsconfig.package.json",
    "dev": "tsc --watch",
    "test": "bun test scripts/tests/test-runner.spec.ts && bun scripts/test.ts",
    "test:isolated": "bun test scripts/tests/test-runner.spec.ts && bun scripts/test.ts",
    "test:shared": "bun test",
    "test:architecture": "bun test scripts/architecture/tests",
    "architecture:host-isolation": "bun scripts/architecture/host-isolation.ts",
    "architecture:capabilities": "bun scripts/architecture/capability-boundaries.ts",
    "architecture:check": "bun run architecture:host-isolation && bun run architecture:capabilities && bun run test:architecture",
    "prepublishOnly": "bun run build",
    "prepack": "bun run build:package"
  },
  "dependencies": {
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.3.2",
    "@langchain/openai": "1.4.7",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "dotenv": "16.6.1",
    "typescript": "5.9.3"
  }
}
