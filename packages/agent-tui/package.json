{
  "name": "@indexnetwork/agent-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A live terminal testing platform for personal agents and parallel negotiations.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run --cwd ../agent build && bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && eslint src"
  },
  "dependencies": {
    "@indexnetwork/agent": "workspace:*",
    "@opentui/core": "0.5.10"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
