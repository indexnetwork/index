     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select count(distinct opportunity_id) filter (where type = 'committed')::float / nullif(count(distinct opportunity_id) filter (where type = 'agreed'), 0) as value from analytics.opportunity_events where $__timeFilter(at)"
    }
