  },
  {
   "id": 8,
   "type": "stat",
   "title": "Median hours from opened to first commit",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 8,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select percentile_cont(0.5) within group (order by extract(epoch from (c.t - o.at))/3600) as value from (select opportunity_id, at from analytics.opportunity_events where type = 'opened' and $__timeFilter(at)) o join (select opportunity_id, min(at) as t from analytics.opportunity_events where type = 'committed' group by 1) c using (opportunity_id)"
    }
   ]
  },
