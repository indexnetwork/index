{
 "uid": "index-negotiation",
 "title": "Index - Negotiation health",
 "tags": [
  "index"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Negotiations started",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select count(*) as value from analytics.negotiations where $__timeFilter(created_at)"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Agreement rate (agreed / settled)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select count(*) filter (where outcome = 'agreed')::float / nullif(count(*) filter (where outcome is not null), 0) as value from analytics.negotiations where $__timeFilter(created_at)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "In talks now",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select count(*) as value from analytics.negotiations where outcome is null"
    }
   ],
   "description": "Every negotiation the agents have not agreed on and nobody has closed, including ones paused after a decline or a full round."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "In talks for more than 24h",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select count(*) as value from analytics.negotiations where outcome is null and created_at < now() - interval '24 hours'"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Negotiations started per day by outcome",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select $__timeGroupAlias(created_at,'1d'), coalesce(outcome, 'in talks') as metric, count(*) as value from analytics.negotiations where $__timeFilter(created_at) group by 1,2 order by 1"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Median turns per negotiation",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select percentile_cont(0.5) within group (order by n) as value from (select t.negotiation_id, count(*) as n from analytics.negotiation_turns t join analytics.negotiations g on g.id = t.negotiation_id where $__timeFilter(g.created_at) group by 1) x"
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Median hours to settle",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 6,
    "y": 13,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select percentile_cont(0.5) within group (order by extract(epoch from (settled_at - created_at))/3600) as value from analytics.negotiations where settled_at is not null and $__timeFilter(created_at)"
    }
   ]
  },
  {
   "id": 8,
   "type": "bargauge",
   "title": "Turns by action",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": true
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select action, count(*) as turns from analytics.negotiation_turns where $__timeFilter(created_at) group by 1 order by 2 desc"
    }
   ]
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Agent passes (decline turns)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select count(*) as value from analytics.negotiation_turns where action = 'decline' and $__timeFilter(created_at)"
    }
   ],
   "description": "A decline pauses the pair rather than ending it, so it is counted as a turn, not as an outcome."
  },
  {
   "id": 10,
   "type": "stat",
   "title": "Pass rate (decline turns / negotiations started)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "index-pg"
   },
   "gridPos": {
    "x": 6,
    "y": 17,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "index-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select (select count(*) from analytics.negotiation_turns where action = 'decline' and $__timeFilter(created_at))::float / nullif((select count(*) from analytics.negotiations where $__timeFilter(created_at)), 0) as value"
    }
   ],
   "description": "Can pass 100%: a pair resumed by new context can be passed on again."
  }
 ],
 "templating": {
  "list": []
 }
}
