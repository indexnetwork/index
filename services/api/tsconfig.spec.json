// `bun run build` compiles tsconfig.json, which excludes `src/**/*.spec.ts`, so
// no spec is type-checked by it. That matters where an assertion *is* a type
// assertion: `discovery-trigger.builders.spec.ts` proves with three
// `@ts-expect-error` directives that trigger callers must pass a concrete
// `networkId`, and a directive nobody compiles proves nothing.
//
// Scope note: this include list is deliberately narrow. It is not the whole
// `src/queues/tests` directory — widening it would adopt pre-existing type
// errors in unrelated specs, which is its own follow-up.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src/queues/tests/discovery-trigger.builders.spec.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
