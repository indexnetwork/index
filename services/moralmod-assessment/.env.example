# Bearer Index presents (same value as Index's MORALMOD_ASSESSMENT_TOKEN)
ASSESSMENT_API_TOKEN=

# Providers. BOTH are required per run: the pipeline's state and utility
# stages call the TypeSafe "Jev" model unconditionally. The TypeSafe key
# comes from the lab.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Pipeline profile
PIPELINE_MODEL=openai/gpt-5.6-luna
PIPELINE_MODE=mutual_benefit   # or "full" (needs a severity cache for the model/effort)
REASONING_EFFORT=none          # "none" ≈ 22s/run; "default" ≈ 76s/run on luna
N_SAMPLES=100
MAX_CONCURRENT_RUNS=4
RUN_TTL_SECONDS=3600
